DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require&channel_binding=require
NEON_BRANCH=production
API_ACCESS_TOKEN=
# Neon 分支 Auth URL，必须与令牌 iss 完全一致，不带末尾斜杠。
NEON_AUTH_ISSUER=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
API_RESOURCE=https://api.exts.linguio.dev
# 单独生成并放在 Vercel 服务端，不能使用用户访问令牌代替。
CRON_SECRET=
# 仅供显式隔离的空 PostgreSQL 测试库，不得填写生产认证库连接。
API_TEST_DATABASE_URL=
