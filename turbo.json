{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#web:dev": {
      "cache": false,
      "persistent": true
    },
    "//#ext:dev": {
      "cache": false,
      "persistent": true
    },
    "//#desk:dev": {
      "cache": false,
      "persistent": true
    },
    "//#api:dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
