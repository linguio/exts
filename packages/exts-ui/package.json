{
  "name": "@linguio/exts-ui",
  "version": "0.1.0",
  "description": "shadcn foundations and reusable Exts UI enhancements",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/linguio/exts.git", "directory": "packages/exts-ui" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "latest" },
  "sideEffects": ["**/*.css"],
  "exports": {
    "./ui/button": "./src/ui/button.tsx",
    "./ui/tooltip": "./src/ui/tooltip.tsx",
    "./ui/toast": "./src/ui/toast.tsx",
    "./plus/toast": "./src/plus/toast/index.ts",
    "./styles.css": { "types": "./src/style-types.d.ts", "default": "./styles.css" }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --maxWorkers 1",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:npm": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:package"
  },
  "npmRelease": { "verify": "verify:npm", "directory": "../../dist/build/npm/exts-ui" },
  "peerDependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
