{
  "name": "@linguio/wxt-stable-output",
  "version": "1.0.1",
  "description": "Keep a validated, last-successful unpacked extension directory during WXT development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linguio/exts.git",
    "directory": "packages/wxt-stable-output"
  },
  "bugs": "https://github.com/linguio/exts/issues",
  "homepage": "https://github.com/linguio/exts/tree/main/packages/wxt-stable-output#readme",
  "keywords": ["wxt", "browser-extension", "development"],
  "files": ["src", "README.md", "README.zh-CN.md", "LICENSE", "CHANGELOG.md"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": "24.16.0" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "scripts": {
    "test": "vitest run --maxWorkers 1",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 tests/consumer-types.mts",
    "verify:integration": "node scripts/verify-package.mjs",
    "verify:npm": "pnpm test && pnpm typecheck && pnpm verify:integration"
  },
  "npmRelease": { "verify": "verify:npm" },
  "peerDependencies": { "wxt": "0.21.4" },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  }
}
